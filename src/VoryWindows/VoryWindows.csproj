    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>VoryWindows</AssemblyName>
    <RootNamespace>VoryWindows</RootNamespace>
