<Window x:Class="VoryWindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VoryWindows.ViewModels"
        Title="Vory" Width="1280" Height="820" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TitleBarCloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="0,13,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B90D1B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="ChromeBorder" CornerRadius="14" BorderThickness="1"
            Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ================= custom titlebar ================= -->
            <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="TitleBarDrag" Background="Transparent"
                          MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{StaticResource Accent}" Offset="0"/>
                                        <GradientStop Color="{StaticResource AccentDeep}" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="VORY" FontWeight="Bold" FontSize="13" Margin="10,0,0,1"
                                       VerticalAlignment="Center"/>
                            <Border Width="1" Height="14" Background="{StaticResource BorderBrush}" Margin="14,0"/>
                            <TextBlock Text="{Binding ActiveGatewayName}" Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center"/>
                            <Grid Width="26" Height="26" Margin="10,0,0,0" VerticalAlignment="Center"
                                  ToolTip="Connection status">
                                <Ellipse x:Name="ConnHalo" Fill="{StaticResource OrbGlowBrush}" Opacity="0"/>
                                <Ellipse x:Name="ConnDot" Width="9" Height="9"
                                         Fill="{StaticResource DangerBrush}"/>
                            </Grid>
                            <TextBlock x:Name="ConnLabel" Text="Offline" FontSize="11"
                                       Style="{StaticResource FaintText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch">
                        <Button Style="{StaticResource TitleBarButton}" Content="─" Click="MinButton_Click"
                                ToolTip="Minimize"/>
                        <Button x:Name="MaxButton" Style="{StaticResource TitleBarButton}" Content="▢"
                                Click="MaxButton_Click" ToolTip="Maximize"/>
                        <Button Style="{StaticResource TitleBarCloseButton}" Content="✕"
                                Click="CloseButton_Click" ToolTip="Close"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= 503 restart banner ================= -->
            <Border Grid.Row="1" Background="#2A1E0E" BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="0,0,0,1" Padding="16,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RestartRequired}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⟳ " Foreground="{DynamicResource WarningBrush}" FontSize="14"/>
                    <TextBlock Text="Restart required — " FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="{Binding RestartDetail}" Foreground="White" Margin="0,0,16,0"/>
                    <Button Content="Update Hermes" Command="{Binding UpdateHermesCommand}" Margin="0,0,8,0"/>
                    <Button Content="Restart gateway" Command="{Binding RestartGatewayCommand}"
                            Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Border>

            <!-- ================= body ================= -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76"/>
                    <ColumnDefinition Width="{Binding SidebarWidth}"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- vector icon rail -->
                <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <StackPanel HorizontalAlignment="Center" Margin="0,12,0,0">
                        <Button Style="{StaticResource IconRailButton}" ToolTip="Home"
                                Command="{Binding NavigateCommand}" CommandParameter="Home">
                            <Grid Width="46" Height="46">
                                <Border CornerRadius="14" Margin="5,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                    <Setter Property="Background" Value="#1AFFFFFF"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Static vm:AppPage.Home}">
                                                    <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Path Data="{StaticResource IconHome}" Width="19" Height="19" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="{StaticResource FaintBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource TextBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Static vm:AppPage.Home}">
                                                    <Setter Property="Fill" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource IconRailButton}" ToolTip="Chats"
                                Command="{Binding NavigateCommand}" CommandParameter="Chats">
                            <Grid Width="46" Height="46">
                                <Border CornerRadius="14" Margin="5,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                    <Setter Property="Background" Value="#1AFFFFFF"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Static vm:AppPage.Chats}">
                                                    <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Path Data="{StaticResource IconChat}" Width="19" Height="19" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="{StaticResource FaintBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource TextBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Static vm:AppPage.Chats}">
                                                    <Setter Property="Fill" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource IconRailButton}" ToolTip="Bots"
                                Command="{Binding NavigateCommand}" CommandParameter="Bots">
                            <Grid Width="46" Height="46">
                                <Border CornerRadius="14" Margin="5,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                    <Setter Property="Background" Value="#1AFFFFFF"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Static vm:AppPage.Bots}">
                                                    <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Path Data="{StaticResource IconBot}" Width="19" Height="19" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="{StaticResource FaintBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource TextBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Static vm:AppPage.Bots}">
                                                    <Setter Property="Fill" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource IconRailButton}" ToolTip="Files"
                                Command="{Binding NavigateCommand}" CommandParameter="Files">
                            <Grid Width="46" Height="46">
                                <Border CornerRadius="14" Margin="5,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                    <Setter Property="Background" Value="#1AFFFFFF"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Static vm:AppPage.Files}">
                                                    <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Path Data="{StaticResource IconFolder}" Width="19" Height="19" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="{StaticResource FaintBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource TextBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Static vm:AppPage.Files}">
                                                    <Setter Property="Fill" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource IconRailButton}" ToolTip="Settings"
                                Command="{Binding NavigateCommand}" CommandParameter="Settings">
                            <Grid Width="46" Height="46">
                                <Border CornerRadius="14" Margin="5,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                    <Setter Property="Background" Value="#1AFFFFFF"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Static vm:AppPage.Settings}">
                                                    <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Path Data="{StaticResource IconSliders}" Width="19" Height="19" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="{StaticResource FaintBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource TextBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Static vm:AppPage.Settings}">
                                                    <Setter Property="Fill" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- sidebar -->
                <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <ContentControl Content="{Binding Sidebar}"/>
                </Border>

                <!-- main content -->
                <ContentControl Grid.Column="2" Content="{Binding Content}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
