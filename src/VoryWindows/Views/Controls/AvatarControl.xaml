<UserControl x:Class="VoryWindows.Views.Controls.AvatarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="40" Height="40">
    <Canvas x:Name="Face" Width="40" Height="40">
        <Ellipse x:Name="Head" Width="40" Height="40" Fill="#5B8DEF"/>
        <Ellipse x:Name="EyeL" Width="6" Height="8" Canvas.Left="11" Canvas.Top="14" Fill="White"/>
        <Ellipse x:Name="EyeR" Width="6" Height="8" Canvas.Left="23" Canvas.Top="14" Fill="White"/>
        <Path x:Name="Smile" Stroke="White" StrokeThickness="2" Fill="Transparent"
              Data="M 14,27 Q 20,31 26,27"/>
    </Canvas>
</UserControl>
