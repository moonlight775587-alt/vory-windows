<UserControl x:Class="VoryWindows.Views.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VoryWindows.Views.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28">
        <StackPanel MaxWidth="980">
            <StackPanel.RenderTransform>
                <TranslateTransform Y="0"/>
            </StackPanel.RenderTransform>
            <StackPanel.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard Storyboard="{StaticResource PageEnter}"/>
                </EventTrigger>
            </StackPanel.Triggers>

            <!-- ============ hero ============ -->
            <TextBlock Text="COMMAND DECK" Style="{StaticResource EyebrowText}"/>
            <TextBlock Text="{Binding Greeting}" Style="{StaticResource DisplayText}" Margin="0,0,0,20"/>
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,12"/>

            <!-- ============ stat cards ============ -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource GlassCard}" Margin="0,0,8,8" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="{Binding Sessions}" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="SESSIONS" FontSize="10" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource GlassCard}" Margin="4,0,4,8" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="{Binding Messages}" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="MESSAGES" FontSize="10" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource GlassCard}" Margin="8,0,0,8" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="{Binding Tokens}" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="TOKENS" FontSize="10" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource GlassCard}" Margin="0,0,8,8" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="{Binding ActiveDays}" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="ACTIVE DAYS" FontSize="10" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource GlassCard}" Margin="4,0,4,8" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="{Binding PeakHourLabel}" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="PEAK HOUR" FontSize="10" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource GlassCard}" Margin="8,0,0,8" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="{Binding TopModel}" FontSize="17" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Height="41"/>
                        <TextBlock Text="TOP MODEL" FontSize="10" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ activity ============ -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="ACTIVITY" Style="{StaticResource EyebrowText}" Margin="0"/>
                            <TextBlock Margin="0,2,0,0">
                                <Run Text="Est. cost  " Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                                <Run Text="{Binding CostEstimate}" FontWeight="SemiBold"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="7d" Command="{Binding SetDaysCommand}" CommandParameter="7" Margin="0,0,6,0"/>
                            <Button Content="30d" Command="{Binding SetDaysCommand}" CommandParameter="30" Margin="0,0,6,0"/>
                            <Button Content="90d" Command="{Binding SetDaysCommand}" CommandParameter="90"/>
                        </StackPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ActivityBlocks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="15" Height="15" Margin="2" CornerRadius="4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="1">
                                                    <Setter Property="Background" Value="#2E4A2E"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="2">
                                                    <Setter Property="Background" Value="#3E6B3E"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="3">
                                                    <Setter Property="Background" Value="#46A758"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="4">
                                                    <Setter Property="Background" Value="#7DD87D"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ============ bots ============ -->
            <Grid Margin="0,4,0,12">
                <TextBlock Text="YOUR BOTS" Style="{StaticResource EyebrowText}" Margin="0" VerticalAlignment="Center"/>
                <Button Content="View all →" Command="{Binding OpenBotsCommand}" Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding Bots}" Margin="0,0,0,8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource GlassCard}" Width="210" Margin="0,0,12,12" Padding="18">
                            <StackPanel>
                                <controls:AvatarControl Width="46" Height="46" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Model}" FontSize="11" Style="{StaticResource MutedText}"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ============ resume ============ -->
            <TextBlock Text="PICK UP WHERE YOU LEFT OFF" Style="{StaticResource EyebrowText}" Margin="0,4,0,12"/>
            <ItemsControl ItemsSource="{Binding Recent}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Padding="6" Margin="0,0,0,8">
                            <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch"
                                    Command="{Binding DataContext.OpenChatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Preview}" FontSize="11" Style="{StaticResource MutedText}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="→" Foreground="{DynamicResource FaintBrush}"
                                               VerticalAlignment="Center" Margin="12,0,4,0"/>
                                </Grid>
                            </Button>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
