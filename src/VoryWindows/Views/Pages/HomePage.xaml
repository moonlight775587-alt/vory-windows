<UserControl x:Class="VoryWindows.Views.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VoryWindows.Views.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="900">
            <TextBlock Text="{Binding Greeting}" FontSize="26" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,8"/>

            <!-- Overview -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Overview" Style="{StaticResource SectionTitle}" Margin="0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="7d" Command="{Binding SetDaysCommand}" CommandParameter="7" Margin="0,0,4,0"/>
                            <Button Content="30d" Command="{Binding SetDaysCommand}" CommandParameter="30" Margin="0,0,4,0"/>
                            <Button Content="90d" Command="{Binding SetDaysCommand}" CommandParameter="90"/>
                        </StackPanel>
                    </Grid>
                    <UniformGrid Columns="3" Rows="2">
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{Binding Sessions}" FontSize="24" FontWeight="Bold"/>
                            <TextBlock Text="Sessions" Style="{StaticResource MutedText}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{Binding Messages}" FontSize="24" FontWeight="Bold"/>
                            <TextBlock Text="Messages" Style="{StaticResource MutedText}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{Binding Tokens}" FontSize="24" FontWeight="Bold"/>
                            <TextBlock Text="Tokens" Style="{StaticResource MutedText}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding ActiveDays}" FontSize="24" FontWeight="Bold"/>
                            <TextBlock Text="Active days" Style="{StaticResource MutedText}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding PeakHourLabel}" FontSize="24" FontWeight="Bold"/>
                            <TextBlock Text="Peak hour" Style="{StaticResource MutedText}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding TopModel}" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Top model" Style="{StaticResource MutedText}"/>
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Margin="0,8,0,4">
                        <Run Text="Est. cost: " Foreground="{DynamicResource MutedBrush}"/>
                        <Run Text="{Binding CostEstimate}" FontWeight="SemiBold"/>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding ActivityBlocks}" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="14" Height="14" Margin="2" CornerRadius="3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="1">
                                                    <Setter Property="Background" Value="#2E4A2E"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="2">
                                                    <Setter Property="Background" Value="#3E6B3E"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="3">
                                                    <Setter Property="Background" Value="#46A758"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="4">
                                                    <Setter Property="Background" Value="#7DD87D"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Bots -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Bots" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                <Button Content="View all" Command="{Binding OpenBotsCommand}" Margin="12,0,0,0"
                        VerticalAlignment="Center"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Bots}" Margin="0,0,0,12">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Width="200" Margin="0,0,12,12">
                            <StackPanel>
                                <controls:AvatarControl Width="44" Height="44" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Model}" FontSize="11" Style="{StaticResource MutedText}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Pick up where you left off -->
            <TextBlock Text="Pick up where you left off" Style="{StaticResource SectionTitle}"/>
            <ItemsControl ItemsSource="{Binding Recent}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Padding="10">
                            <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                                    Command="{Binding DataContext.OpenChatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Preview}" FontSize="11" Style="{StaticResource MutedText}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
