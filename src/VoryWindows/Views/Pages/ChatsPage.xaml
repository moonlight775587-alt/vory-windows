<UserControl x:Class="VoryWindows.Views.Pages.ChatsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="12,12,12,8">
            <Button Content="＋ New chat" Style="{StaticResource AccentButton}"
                    Command="{Binding NewChatCommand}" HorizontalAlignment="Stretch"/>
            <TextBox Margin="0,8,0,0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Search chats"/>
            <ComboBox Margin="0,8,0,0" ItemsSource="{Binding Projects}" SelectedItem="{Binding ProjectFilter}"
                      ToolTip="Filter by project"/>
        </StackPanel>

        <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderBrush}" Margin="12,0"/>

        <ListBox Grid.Row="2" ItemsSource="{Binding Filtered}" Margin="6" x:Name="ChatList"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Preview}" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                       TextTrimming="CharacterEllipsis" MaxHeight="28"/>
                            <TextBlock FontSize="10" Foreground="{DynamicResource MutedBrush}">
                                <Run Text="{Binding Profile}"/><Run Text=" · "/>
                                <Run Text="{Binding UpdatedAt, StringFormat='{}{0:g}'}"/>
                            </TextBlock>
                        </StackPanel>
                        <Ellipse Grid.Column="1" Width="10" Height="10" Fill="{DynamicResource WarningBrush}"
                                 VerticalAlignment="Center" Margin="6,0,2,0" ToolTip="Needs you">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NeedsYou}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Grid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open" Command="{Binding PlacementTarget.Tag.OpenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                <MenuItem Header="Pin / unpin" Command="{Binding PlacementTarget.Tag.PinCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                <MenuItem Header="Archive / unarchive" Command="{Binding PlacementTarget.Tag.ArchiveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                <MenuItem Header="Delete" Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                            </ContextMenu>
                        </Grid.ContextMenu>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
