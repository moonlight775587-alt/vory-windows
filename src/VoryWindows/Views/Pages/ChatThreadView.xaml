<UserControl x:Class="VoryWindows.Views.Pages.ChatThreadView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VoryWindows.Views.Controls"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <UserControl.Resources>

        <!-- ============ message templates ============ -->

        <DataTemplate x:Key="UserTemplate">
            <Grid Margin="0,4" HorizontalAlignment="Right" MaxWidth="700">
                <Border Background="{DynamicResource UserBubbleBrush}" CornerRadius="12,12,4,12" Padding="12,8">
                    <StackPanel>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding TimeLabel}" FontSize="10" Opacity="0.6"
                                   HorizontalAlignment="Right" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AssistantTemplate">
            <Grid Margin="0,4" HorizontalAlignment="Left" MaxWidth="700">
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="12,12,12,4" Padding="12,8">
                    <StackPanel>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding TimeLabel}" FontSize="10"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ToolTemplate">
            <Border Margin="0,4" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="10" MaxWidth="700" HorizontalAlignment="Left">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔧 " FontSize="12"/>
                        <TextBlock Text="{Binding ToolName}" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock x:Name="RunningTag" Text="  • running…" FontSize="11"
                                   Foreground="{DynamicResource WarningBrush}" Margin="6,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ToolCommand}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                    <Border Background="{DynamicResource CodeBrush}" CornerRadius="6" Margin="0,6,0,0"
                            MaxHeight="220">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding ToolOutput}" FontFamily="Consolas" FontSize="11"
                                       TextWrapping="NoWrap" Padding="8"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding ToolRunning}" Value="False">
                    <Setter TargetName="RunningTag" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="TodoTemplate">
            <Border Margin="0,4" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="10" MaxWidth="700" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="{Binding ToolName, StringFormat='☑ {0}'}" FontWeight="SemiBold" FontSize="12"/>
                    <ItemsControl ItemsSource="{Binding Todos}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <CheckBox IsChecked="{Binding Done}" IsEnabled="False" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Text}" Margin="6,0,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ApprovalTemplate">
            <Border Margin="0,6" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="14" MaxWidth="700" HorizontalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="⚠ Approval requested" FontWeight="SemiBold"
                               Foreground="{DynamicResource WarningBrush}"/>
                    <TextBlock Text="{Binding Text}" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ToolCommand}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                    <StackPanel x:Name="Buttons" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Once" Margin="0,0,6,0"
                                Command="{Binding DataContext.ApproveOnceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                        <Button Content="Session" Margin="0,0,6,0"
                                Command="{Binding DataContext.ApproveSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                        <Button Content="Always" Margin="0,0,6,0"
                                Command="{Binding DataContext.ApproveAlwaysCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                        <Button Content="Deny"
                                Command="{Binding DataContext.DenyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                    </StackPanel>
                    <TextBlock x:Name="AnsweredTag" Text="Answered ✓" Foreground="{DynamicResource SuccessBrush}"
                               Margin="0,10,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Answered}" Value="True">
                    <Setter TargetName="Buttons" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="AnsweredTag" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="PromptTemplate">
            <Border Margin="0,6" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="14" MaxWidth="700" HorizontalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="{Binding Text}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ToolOutput}" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/>
                    <StackPanel x:Name="InputRow" Margin="0,10,0,0">
                        <TextBox x:Name="PromptInput" Text="{Binding ToolCommand, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="Collapsed"/>
                        <PasswordBox x:Name="PromptSecret" Visibility="Collapsed" Margin="0,0,0,0"/>
                        <Button Content="Send" Style="{StaticResource AccentButton}" Margin="0,8,0,0"
                                HorizontalAlignment="Left" Click="PromptAnswer_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="AnsweredTag" Text="Answered ✓" Foreground="{DynamicResource SuccessBrush}"
                               Margin="0,10,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Prompt.IsSecret}" Value="False">
                    <Setter TargetName="PromptInput" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Prompt.IsSecret}" Value="True">
                    <Setter TargetName="PromptSecret" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Answered}" Value="True">
                    <Setter TargetName="InputRow" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="AnsweredTag" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="NoticeTemplate">
            <StackPanel Margin="0,8" HorizontalAlignment="Center" MaxWidth="700">
                <Border Background="{DynamicResource Surface2Brush}" CornerRadius="12" Padding="10,6">
                    <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Center" TextWrapping="Wrap"/>
                </Border>
                <TextBlock Text="{Binding ToolOutput}" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap" Margin="0,4,0,0" MaxWidth="600"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="StatsTemplate">
            <TextBlock Text="{Binding Text}" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                       HorizontalAlignment="Center" Margin="0,6"/>
        </DataTemplate>

        <DataTemplate x:Key="SystemTemplate">
            <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                       FontStyle="Italic" HorizontalAlignment="Center" TextWrapping="Wrap"
                       Margin="0,6" MaxWidth="700"/>
        </DataTemplate>

        <controls:ChatTemplateSelector x:Key="Selector"
            UserTemplate="{StaticResource UserTemplate}"
            AssistantTemplate="{StaticResource AssistantTemplate}"
            ToolTemplate="{StaticResource ToolTemplate}"
            TodoTemplate="{StaticResource TodoTemplate}"
            ApprovalTemplate="{StaticResource ApprovalTemplate}"
            PromptTemplate="{StaticResource PromptTemplate}"
            NoticeTemplate="{StaticResource NoticeTemplate}"
            StatsTemplate="{StaticResource StatsTemplate}"
            SystemTemplate="{StaticResource SystemTemplate}"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:AvatarControl Width="32" Height="32" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="{Binding BotStatus}" FontSize="11"
                                   Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding CurrentModel, FallbackValue='🧠 Model'}"
                            Command="{Binding ToggleModelPickerCommand}" Margin="0,0,6,0"
                            ToolTip="Model picker (session-scoped)"/>
                    <Button Content="＋ New" Command="{Binding DataContext.NewChatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- thread -->
        <ScrollViewer Grid.Row="1" x:Name="ThreadScroller" VerticalScrollBarVisibility="Auto" Padding="16,8">
            <ItemsControl x:Name="ThreadItems" ItemsSource="{Binding Items}"
                          ItemTemplateSelector="{StaticResource Selector}"/>
        </ScrollViewer>

        <!-- attachments -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Attachments}" Margin="12,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource Surface2Brush}" CornerRadius="6" Padding="8,4" Margin="0,0,6,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📎 "/>
                            <TextBlock Text="{Binding Name}" FontSize="12"/>
                            <Button Content="✕" Style="{StaticResource GhostButton}" Padding="6,0" Margin="6,0,0,0"
                                    Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <!-- composer -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="📎" FontSize="16" Style="{StaticResource GhostButton}"
                        Command="{Binding AttachCommand}" ToolTip="Attach file" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" x:Name="ComposerBox" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" MaxHeight="120" MinHeight="34"
                         Text="{Binding ComposerText, UpdateSourceTrigger=PropertyChanged}"
                         PreviewKeyDown="ComposerBox_PreviewKeyDown"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Bottom">
                    <Button x:Name="SendButton" Content="➤" ToolTip="Send (Enter)"
                            Command="{Binding SendCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Streaming}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="StopButton" Content="■" ToolTip="Stop"
                            Command="{Binding StopCommand}" Margin="6,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Streaming}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- slash autocomplete -->
        <Popup IsOpen="{Binding ShowSuggestions}" PlacementTarget="{Binding ElementName=ComposerBox}"
               Placement="Top" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="220">
                <ListBox ItemsSource="{Binding Suggestions}" BorderThickness="0" Background="Transparent"
                         MouseDoubleClick="Suggestions_DoubleClick" x:Name="SuggestionsList"/>
            </Border>
        </Popup>

        <!-- model picker -->
        <Popup IsOpen="{Binding ShowModelPicker}" Placement="Center" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="12" Width="420" MaxHeight="480">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Model (this session only)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding ModelGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Provider}" FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                                        <ItemsControl ItemsSource="{Binding Models}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Label}" HorizontalContentAlignment="Left"
                                                            Margin="0,2" Padding="8,6"
                                                            Command="{Binding ElementName=Root, Path=DataContext.PickModelCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>
