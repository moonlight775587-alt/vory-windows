<UserControl x:Class="VoryWindows.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VoryWindows.ViewModels">
    <UserControl.Resources>

        <!-- ================= section templates ================= -->

        <DataTemplate DataType="{x:Type vm:GatewaysSettingsVm}">
            <StackPanel MaxWidth="700">
                <TextBlock Text="Gateways" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding Gateways}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding BaseUrl}" FontSize="11" Style="{StaticResource MutedText}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Use" Margin="0,0,6,0"
                                                Command="{Binding DataContext.ActivateCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Edit" Margin="0,0,6,0"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Delete"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="＋ Add gateway" Style="{StaticResource AccentButton}" Command="{Binding AddCommand}" Margin="0,0,8,0"/>
                    <Button Content="⟳ Reconnect" Command="{Binding ReconnectCommand}"/>
                </StackPanel>
                <TextBlock Text="Credentials are encrypted with DPAPI in %APPDATA%\VoryWindows\gateways.dat"
                           Style="{StaticResource MutedText}" FontSize="11" Margin="0,12,0,0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ModelSettingsVm}">
            <StackPanel MaxWidth="700">
                <TextBlock Text="Model" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}"/>
                <TextBlock Text="Default model" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Options}" DisplayMemberPath="Label"
                          SelectedValue="{Binding SelectedModel}" SelectedValuePath="Label" Margin="0,0,0,8"/>
                <TextBlock Text="Auxiliary model" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding Auxiliary}" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
                <Button Content="Save" Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}"
                        HorizontalAlignment="Left"/>
                <TextBlock Text="Mid-chat changes are session-scoped (never model.default)."
                           Style="{StaticResource MutedText}" FontSize="11" Margin="0,12,0,0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ConfigSettingsVm}">
            <StackPanel MaxWidth="800">
                <TextBlock Text="Config" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}"/>
                <DataGrid ItemsSource="{Binding Entries}" AutoGenerateColumns="False" CanUserAddRows="False"
                          Margin="0,0,0,8" MaxHeight="440" Background="{DynamicResource SurfaceBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="220" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Button Content="Save (deep-merge)" Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}"
                        HorizontalAlignment="Left"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:EnvSettingsVm}">
            <StackPanel MaxWidth="800">
                <TextBlock Text="Env / API keys" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}"/>
                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                                <Button Grid.Column="2" Content="Save" Margin="0,0,6,0"
                                        Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                        CommandParameter="{Binding}"/>
                                <Button Grid.Column="3" Content="Delete"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="＋ Add variable" Command="{Binding AddCommand}" HorizontalAlignment="Left" Margin="0,4,0,0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ToolsSettingsVm}">
            <StackPanel MaxWidth="700">
                <TextBlock Text="Tools" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}"/>
                <ItemsControl ItemsSource="{Binding Toolsets}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                              Margin="0,0,10,0"
                                              Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                              CommandParameter="{Binding}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11" Style="{StaticResource MutedText}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SkillsSettingsVm}">
            <StackPanel MaxWidth="700">
                <TextBlock Text="Skills" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}"/>
                <ItemsControl ItemsSource="{Binding Skills}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                              Margin="0,0,10,0"
                                              Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                              CommandParameter="{Binding}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11" Style="{StaticResource MutedText}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:McpSettingsVm}">
            <StackPanel MaxWidth="700">
                <TextBlock Text="MCP servers" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}"/>
                <ItemsControl ItemsSource="{Binding Servers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                              Margin="0,0,10,0" Content="{Binding Name}"
                                              Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                              CommandParameter="{Binding}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="11"
                                               Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Content="Test" Margin="0,0,6,0"
                                                Command="{Binding DataContext.TestCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Delete"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ApprovalsSettingsVm}">
            <StackPanel MaxWidth="500">
                <TextBlock Text="Approvals" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}"/>
                <TextBlock Text="Mode" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" Margin="0,0,0,8"/>
                <TextBlock Text="Timeout (seconds)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Timeout, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                <Button Content="Save" Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}"
                        HorizontalAlignment="Left"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CronSettingsVm}">
            <StackPanel MaxWidth="800">
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Cron jobs" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                    <Button Content="＋ Add job" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Command="{Binding AddCommand}"/>
                </Grid>
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}"/>
                <ItemsControl ItemsSource="{Binding Jobs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock FontSize="11" Style="{StaticResource MutedText}">
                                            <Run Text="{Binding Schedule}"/><Run Text=" · "/><Run Text="{Binding LastRun}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Pause" Margin="0,0,6,0"
                                                Command="{Binding DataContext.PauseCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Resume" Margin="0,0,6,0"
                                                Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Trigger" Margin="0,0,6,0"
                                                Command="{Binding DataContext.TriggerCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Delete"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SessionsSettingsVm}">
            <StackPanel MaxWidth="800">
                <TextBlock Text="Sessions" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Width="300" Margin="0,0,8,0"/>
                    <Button Content="Search" Command="{Binding SearchCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding Stats}" FontFamily="Consolas" FontSize="11"
                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding Sessions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="11" Style="{StaticResource MutedText}">
                                            <Run Text="{Binding Profile}"/><Run Text=" · "/>
                                            <Run Text="{Binding UpdatedAt, StringFormat='{}{0:g}'}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Delete"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ChannelsSettingsVm}">
            <StackPanel MaxWidth="700">
                <TextBlock Text="Channels (read-only)" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}"/>
                <TextBox Text="{Binding Platforms}" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="300" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SystemSettingsVm}">
            <StackPanel MaxWidth="800">
                <TextBlock Text="System" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}"/>
                <TextBlock Text="Status" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Text="{Binding StatusText}" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                         AcceptsReturn="True" Height="160" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="Logs" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Logs}" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                         AcceptsReturn="True" Height="220" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Run doctor" Style="{StaticResource AccentButton}" Command="{Binding DoctorCommand}" Margin="0,0,8,0"/>
                </StackPanel>
                <TextBox Text="{Binding DoctorResult}" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                         AcceptsReturn="True" Height="140" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MaintenanceSettingsVm}">
            <StackPanel MaxWidth="700">
                <TextBlock Text="Maintenance" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Check for updates" Command="{Binding CheckCommand}" Margin="0,0,8,0"/>
                    <Button Content="Update Hermes" Command="{Binding UpdateCommand}" Margin="0,0,8,0"/>
                    <Button Content="Restart gateway" Command="{Binding RestartCommand}"/>
                </StackPanel>
                <TextBlock Text="Update check" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Text="{Binding CheckResult}" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                         AcceptsReturn="True" Height="100" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="Action status" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Text="{Binding ActionStatus}" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                         AcceptsReturn="True" Height="160" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Tail hermes-update" Command="{Binding TailCommand}" CommandParameter="hermes-update" Margin="0,0,8,0"/>
                    <Button Content="Tail gateway-restart" Command="{Binding TailCommand}" CommandParameter="gateway-restart"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PluginsSettingsVm}">
            <StackPanel MaxWidth="700">
                <TextBlock Text="Plugins (read-only)" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}"/>
                <ItemsControl ItemsSource="{Binding Plugins}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Padding="10">
                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AppearanceSettingsVm}">
            <StackPanel MaxWidth="500">
                <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Your name (Home greeting)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                <TextBlock Text="Accent color" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ItemsControl ItemsSource="{Binding Accents}" Margin="0,0,0,12">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="40" Height="40" Margin="0,0,8,8" Tag="{Binding}"
                                    Click="Accent_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{Binding}" CornerRadius="20" Width="40" Height="40"
                                                BorderBrush="White" BorderThickness="0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <CheckBox Content="Dark theme" IsChecked="{Binding DarkTheme}" Margin="0,0,0,12"/>
                <Button Content="Apply" Style="{StaticResource AccentButton}" Command="{Binding ApplyCommand}"
                        HorizontalAlignment="Left"/>
            </StackPanel>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ListBox Grid.Column="0" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}"
                 Margin="12" BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Glyph}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Title}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"/>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24">
            <ContentControl Content="{Binding CurrentSectionVm}"/>
        </ScrollViewer>
    </Grid>
</UserControl>
