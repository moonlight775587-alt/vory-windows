<Window x:Class="VoryWindows.Views.Dialogs.CronJobDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New cron job" Width="460" Height="340" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    <StackPanel Margin="20">
        <TextBlock Text="Name" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox x:Name="NameBox" Margin="0,0,0,12"/>
        <TextBlock Text="Schedule (cron expression)" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox x:Name="ScheduleBox" Margin="0,0,0,12" ToolTip="e.g. 0 9 * * *"/>
        <TextBlock Text="Command / prompt" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox x:Name="CommandBox" AcceptsReturn="True" Height="80" TextWrapping="Wrap" Margin="0,0,0,16"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0"/>
            <Button Content="Create" Style="{StaticResource AccentButton}" Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
