<Window x:Class="VoryWindows.Views.Dialogs.GatewayDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gateway" Width="520" Height="640" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <TextBlock Text="Name" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="NameBox" Margin="0,0,0,12"/>

            <TextBlock Text="Gateway URL" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="UrlBox" Margin="0,0,0,4"
                     ToolTip="e.g. https://hermes.example.com or http://192.168.1.20:9119"/>
            <TextBlock x:Name="LanWarning" Foreground="{DynamicResource WarningBrush}" FontSize="11"
                       Margin="0,0,0,12" Visibility="Collapsed"
                       Text="Plain http:// to a non-private host. Anyone on the path can read your traffic."/>

            <TextBlock Text="Authentication" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ComboBox x:Name="AuthModeBox" Margin="0,0,0,12" SelectionChanged="AuthModeBox_SelectionChanged">
                <ComboBoxItem Content="Session token" Tag="0"/>
                <ComboBoxItem Content="Username &amp; password" Tag="1"/>
                <ComboBoxItem Content="Sign in with browser" Tag="2"/>
            </ComboBox>

            <StackPanel x:Name="TokenPanel" Margin="0,0,0,12">
                <TextBlock Text="HERMES_DASHBOARD_SESSION_TOKEN" Margin="0,0,0,4"/>
                <PasswordBox x:Name="TokenBox"/>
            </StackPanel>

            <StackPanel x:Name="UserPassPanel" Visibility="Collapsed" Margin="0,0,0,12">
                <TextBlock Text="Username" Margin="0,0,0,4"/>
                <TextBox x:Name="UsernameBox" Margin="0,0,0,8"/>
                <TextBlock Text="Password" Margin="0,0,0,4"/>
                <PasswordBox x:Name="PasswordBox"/>
                <TextBlock Text="The password is used once to sign in and never stored."
                           Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel x:Name="OidcPanel" Visibility="Collapsed" Margin="0,0,0,12">
                <TextBlock Text="Authorize URL template (from your gateway's auth docs):"
                           Margin="0,0,0,4"/>
                <TextBox x:Name="AuthorizeUrlBox" Margin="0,0,0,8"
                         ToolTip="Use {PORT} for the loopback port and {CHALLENGE} for the PKCE challenge"/>
                <Button Content="Sign in with browser" Click="OidcSignIn_Click" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                <TextBlock Text="…or paste the authorization code manually:" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="ManualCodeBox" Width="280" Margin="0,0,8,0"/>
                    <Button Content="Use code" Click="ManualCode_Click"/>
                </StackPanel>
                <TextBlock x:Name="OidcStatus" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>

            <TextBlock Text="Cloudflare Access (optional)" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="CF-Access-Client-Id" Margin="0,0,0,4"/>
            <TextBox x:Name="CfIdBox" Margin="0,0,0,8"/>
            <TextBlock Text="CF-Access-Client-Secret" Margin="0,0,0,4"/>
            <PasswordBox x:Name="CfSecretBox" Margin="0,0,0,12"/>

            <Button Content="Test connection" Click="Test_Click" HorizontalAlignment="Left" Margin="0,0,0,8"/>
            <ItemsControl x:Name="LegResults" Margin="0,0,0,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="✓ " Foreground="{DynamicResource SuccessBrush}" x:Name="OkMark" Visibility="Collapsed"/>
                            <TextBlock Text="✗ " Foreground="{DynamicResource DangerBrush}" x:Name="FailMark" Visibility="Collapsed"/>
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="{Binding Name}" FontWeight="SemiBold"/><Run Text=": "/><Run Text="{Binding Detail}"/>
                            </TextBlock>
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Passed}" Value="True">
                                <Setter TargetName="OkMark" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Passed}" Value="False">
                                <Setter TargetName="FailMark" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button Content="Save" Style="{StaticResource AccentButton}" x:Name="SaveButton"
                        Click="Save_Click" IsEnabled="False"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
